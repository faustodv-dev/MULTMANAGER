# Só o index.php responde; o restante da pasta fica inacessível pela web.
Options -Indexes

# PHP 8.1 só nesta pasta (o sistema antigo continua na versão dele).
# Necessário quando a ponte fica numa pasta do domínio principal; num subdomínio
# com PHP 8.1 no MultiPHP esta linha é inofensiva.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php81 .php
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    RewriteRule ^(lib|tests|sql)(/|$) - [F,L]
</IfModule>
<FilesMatch "^(?!index\.php$).*\.(php|md|sql|json|lock|txt|dist)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# Repassa os cabeçalhos de assinatura para o PHP (alguns Apache/FastCGI os removem)
SetEnvIf X-Ponte-Ts "(.*)" HTTP_X_PONTE_TS=$1
SetEnvIf X-Ponte-Assinatura "(.*)" HTTP_X_PONTE_ASSINATURA=$1
